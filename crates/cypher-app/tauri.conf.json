{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cypher",
  "version": "0.7.0",
  "identifier": "dev.cypher.terminal",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cypher",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msImplicitSignin --disable-sync --disable-background-networking --disable-component-update --disable-domain-reliability"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
